# Backend API base URL (no trailing slash)
# In dev, leave empty — Vite proxy handles /graphql requests
# In production (Firebase), set to your backend URL
VITE_API_BASE_URL=

# Vite dev server proxy target for GraphQL (not used in production)
GRAPHQL_TARGET=http://127.0.0.1:8000

# ── Chat assistant ───────────────────────────────────────────────
# Endpoint the chat client POSTs to (pydantic-ai VercelAIAdapter in prod).
VITE_CHAT_API_URL=/api/chat
# Use the local fake chat server (app/api/fakeChatServer.ts). Set to "false"
# to talk to the real backend at VITE_CHAT_API_URL instead.
VITE_USE_FAKE_CHAT=true
