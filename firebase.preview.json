{
    "hosting": {
      "public": "build/client",
      "ignore": [
        "firebase.json",
        "firebase.preview.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  }